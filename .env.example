# Neon PostgreSQL Database Credentials Example
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@unpooled-host/neondb?sslmode=require

PGHOST=your-neon-pooler-host.neon.tech
PGUSER=your-user
PGDATABASE=neondb
PGPASSWORD=your-password

PORT=3001
